digraph molic {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.65", splines=true, fontname="Arial", fontsize=18, labelloc=t, label="M01 · folha C — Autorizar e acompanhar o caso\nJulian Ryu Takeda — 22.224.030-1\nContinua o objetivo final O04 · chegar a um atendimento (sem nova abertura)\nCenas = tópicos · u: usuário informa · d: sistema apresenta · u: d: informado e exibido · tracejado = alerta ou recuperação"];
node [fontname="Arial", fontsize=13, color="#343434", penwidth=1.4, margin="0.14,0.08"];
edge [fontname="Arial", fontsize=11, color="#454545", arrowsize=0.7];
REF [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Continua de M01 · folha B (C11)\nMesmo objetivo O04; sem nova abertura"];
C13 [shape="Mrecord", style="solid", label="{M01.C13 · Revisar compartilhamento (O05)|d: Confira o que será enviado. O envio não\l   confirma vaga.\l|signos:\lu: d: resumo (S17)\ld: relato original (S03)\ld: orientação automática (S09) e origem (S21)\ld: animal (S02)\ld: destinatário (S18)\lu: autorização do resumo (S19), desmarcada\lu: autorização da conversa completa (S19),\l      separada e opcional\l}"];
P05 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P05"];
P06 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P06"];
P07 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P07"];
C14 [shape="Mrecord", style="solid", label="{M01.C14 · Acompanhar resposta (O10)|d: Enviado não é aceito; enquanto não houver\l   aceite, o atendimento não está garantido.\l|signos:\ld: caso/encaminhamento (S25)\lu: d: estado do encaminhamento (S20)\ld: resposta da clínica (S23)\ld: origem da informação (S21)\ld: horário do registro (S24)\l}"];
C15 [shape="Mrecord", style="dashed", label="{M01.C15 · Recuperar envio (O09)|d: Envio não confirmado; o conteúdo foi\l   mantido.\l|signos:\ld: estado do encaminhamento (S20): falha\lu: d: resumo (S17) mantido\l}"];
C16 [shape="Mrecord", style="dashed", label="{M01.C16 · Confirmar cancelamento|d: Cancelar não apaga o que a unidade já viu.\l|signos:\ld: caso/encaminhamento (S25)\ld: estado do encaminhamento (S20)\l}"];
C17 [shape="Mrecord", style="solid", label="{M01.C17 · Conversar com a clínica|d: Mensagem da equipe da unidade, com autoria\l   e horário; a pré-triagem não responde aqui.\l|signos:\ld: canal com a clínica (S27)\ld: mensagem profissional (S22)\lu: mensagem do tutor (S27)\ld: origem da informação (S21)\ld: horário do registro (S24)\l}"];
U [shape="box", style="rounded,filled", fillcolor="#d9d9d9", fontsize=13, margin="0.3,0.12", label="Acesso ubíquo: ver outras clínicas\nDisponível em C13–C17.\lLeva à busca sem cancelar o pedido.\l"];
B [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Voltar a M01 · folha B\nOutra unidade ou contato direto"];
fim [shape="doublecircle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
{rank=same; C17; P06;}
REF -> C13 [label="u: compartilhar com unidade\nhabilitada"];
C13 -> P05 [label="u: revisei e autorizo enviar"];
P05 -> C13 [label="d: falta autorização ou\ndestino; nada enviado", style="dashed"];
P05 -> C15 [label="d: envio não confirmado", style="dashed"];
C15 -> P05 [label="u: verificar situação e\nretentar", style="dashed"];
P05 -> C14 [label="d: caso enviado; aguardando\nresposta"];
C14 -> P06 [label="u: consultar atualização\nou avisar que estou a caminho"];
P06 -> C14 [label="d: visualizado, aceito,\nrecusado, a caminho ou\ncancelado, com horário"];
P06 -> C14 [label="d: consulta falhou; último\nestado mantido", style="dashed"];
C14 -> C17 [label="u: abrir a conversa com a\nclínica"];
C17 -> P07 [label="u: enviar mensagem"];
P07 -> C17 [label="d: falha; texto mantido", style="dashed"];
P07 -> C14 [label="d: mensagem registrada"];
C14 -> B [label="u: procurar outra unidade", style="dashed"];
C13 -> B [label="u: não autorizar; contato\ndireto", style="dashed"];
C14 -> C16 [label="u: quero cancelar o envio"];
C16 -> C14 [label="u: manter pedido", style="dashed"];
C16 -> P06 [label="u: confirmar cancelamento"];
U -> B [label="u: ver outras clínicas"];
C14 -> fim [label="u: encerrar consulta\n[gcc: O04 · chegar a um\natendimento]"];
}
