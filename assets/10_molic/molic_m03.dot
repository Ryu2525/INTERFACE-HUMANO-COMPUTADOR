digraph molic {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.65", splines=true, fontname="Arial", fontsize=18, labelloc=t, label="M03 · folha A — Resolver informação insuficiente\nJoão Pedro Gardenghi Peterutto — 22.125.066-5\nAbre o objetivo final O03 · entender o que fazer agora\nCenas = tópicos · u: usuário informa · d: sistema apresenta · u: d: informado e exibido · tracejado = alerta ou recuperação"];
node [fontname="Arial", fontsize=13, color="#343434", penwidth=1.4, margin="0.14,0.08"];
edge [fontname="Arial", fontsize=11, color="#454545", arrowsize=0.7];
inicio [shape="circle", style="filled", fillcolor="black", width="0.22", height="0.22", fixedsize="true", label=""];
C01 [shape="Mrecord", style="solid", label="{M03.C01 · Conferir contexto e lacuna (O01/O02)|d: Ainda faltam informações para dizer se é\l   uma emergência. Isso não significa que\l   esteja tudo bem.\l|signos:\ld: animal (S02)\ld: relato (S03)\ld: início dos sinais (S04)\ld: histórico do animal (S26)\ld: estado da análise (S08)\ld: orientação (S09): informação insuficiente\ld: pergunta complementar (S06)\lu: resposta complementar (S07)\l}"];
C02 [shape="Mrecord", style="solid", label="{M03.C02 · Esclarecer sem adivinhar (O02)|d: Expliquei o que falta e por que pergunto.\l   Não sei não conta como não.\l|signos:\ld: pergunta complementar (S06)\lu: resposta complementar (S07): observado, não\l      ou não sei\l}"];
C03 [shape="Mrecord", style="solid", label="{M03.C03 · Responder pergunta objetiva (O02)|d: Vou sugerir respostas possíveis; escolha a\l   mais próxima ou responda do seu jeito.\l|signos:\ld: pergunta complementar (S06) com respostas\l      sugeridas, incluindo não sei\lu: d: resposta complementar (S07)\l}"];
P01 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P01"];
C04 [shape="Mrecord", style="solid", label="{M03.C04 · Acompanhar complemento|d: Recebi sua resposta e estou considerando de\l   novo; o relato e as respostas anteriores\l   estão guardados.\l|signos:\ld: estado da análise (S08): em análise\ld: resposta complementar (S07) incorporada\l}"];
C05 [shape="Mrecord", style="dashed", label="{M03.C05 · Recuperar complemento (O09)|d: Falha; não há nova orientação confirmada.\l|signos:\ld: estado da análise (S08): falha\lu: d: resposta complementar (S07) mantida\l}"];
C06 [shape="Mrecord", style="dashed", label="{M03.C06 · Reconhecer limite da conversa|d: Ainda não é possível concluir. Procure um\l   veterinário, principalmente se piorar; você\l   pode voltar e contar algo novo.\l|signos:\ld: orientação (S09): informação insuficiente\ld: limites (S11)\ld: próximo passo (S12)\l}"];
U [shape="box", style="rounded,filled", fillcolor="#d9d9d9", fontsize=13, margin="0.3,0.12", label="Acesso ubíquo: buscar ajuda\nDisponível em C01–C06 e na folha B.\lInterrompe a coleta sem inferir não\l   emergência.\l"];
B [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Continua em M03 · folha B\nMesmo objetivo O03: compreender e agir"];
H [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Ir a M01 · folha B\nAbre o objetivo final O04 · chegar a um atendimento"];
fim [shape="doublecircle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
{rank=same; C05; C04; C03;}
C04 -> C06 [style=invis, weight=40];
inicio -> C01 [label="u: consultar pedido de\ncomplemento\n[gco: O03 · entender o que\nfazer agora]"];
C01 -> C02 [label="u: não entendi o que devo\nobservar"];
C02 -> C01 [label="u: voltar à pergunta", style="dashed"];
C01 -> P01 [label="u: enviar o que observei ou\nnão sei"];
P01 -> C04 [label="d: resposta recebida;\nanalisando"];
C04 -> P01 [label="u: consultar andamento"];
P01 -> C03 [label="d: sem avanço; pergunta\nobjetiva"];
C03 -> P01 [label="u: enviar resposta revisada"];
P01 -> C01 [label="d: considerei sua resposta;\nainda falta isto"];
P01 -> C05 [label="d: falha de processamento", style="dashed"];
C05 -> P01 [label="u: tentar novamente", style="dashed"];
P01 -> C06 [label="d: insuficiência persiste sem\navanço"];
P01 -> B [label="d: orientação disponível; veja\no que mudou"];
C06 -> C01 [label="u: tenho nova observação"];
C06 -> H [label="u: procurar profissional"];
U -> H [label="u: buscar ajuda agora"];
C06 -> fim [label="u: parar a conversa\n[gcc: O03 · entender o que\nfazer agora]\n(sem conclusão)"];
}
