digraph molic {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.65", splines=true, fontname="Arial", fontsize=18, labelloc=t, label="M02 · folha B — Pedir complemento e comunicar a decisão\nVinícius de Castro Duarte — 22.224.020-2\nContinua o objetivo final O07 · decidir se a unidade recebe o animal (sem nova abertura)\nCenas = tópicos · u: usuário informa · d: sistema apresenta · u: d: informado e exibido · tracejado = alerta ou recuperação"];
node [fontname="Arial", fontsize=13, color="#343434", penwidth=1.4, margin="0.14,0.08"];
edge [fontname="Arial", fontsize=11, color="#454545", arrowsize=0.7];
REF [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Continua de M02 · folha A (C03)\nMesmo objetivo O07; sem nova abertura"];
C06 [shape="Mrecord", style="solid", label="{M02.C06 · Pedir complemento ao tutor (O11)|d: A pergunta vai ao tutor; a resposta\l   aparecerá como atualização, sem apagar o\l   relato original.\l|signos:\lu: mensagem profissional (S22)\ld: início dos sinais (S04) e outras lacunas\ld: origem da informação (S21)\ld: canal com a clínica (S27)\l}"];
C07 [shape="Mrecord", style="solid", label="{M02.C07 · Confirmar capacidade (O07)|d: Confirma que sua unidade pode receber o\l   animal? O tutor será avisado. Recebimento\l   do caso não é aceite.\l|signos:\lu: resposta da clínica (S23): pode ou não pode\l      receber\lu: mensagem profissional (S22), opcional\ld: estado do encaminhamento (S20)\l}"];
P04 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P04"];
P05 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P05"];
C08 [shape="Mrecord", style="solid", label="{M02.C08 · Consultar comunicação registrada|d: Resposta registrada e identificada como da\l   sua unidade; isso não comprova leitura pelo\l   tutor.\l|signos:\ld: resposta da clínica (S23)\ld: estado do encaminhamento (S20)\ld: canal com a clínica (S27)\ld: origem da informação (S21)\ld: horário do registro (S24)\l}"];
C09 [shape="Mrecord", style="dashed", label="{M02.C09 · Recuperar mensagem (O09)|d: Não foi possível enviar sua mensagem agora;\l   o texto foi mantido.\l|signos:\lu: d: mensagem profissional (S22)\ld: canal com a clínica (S27)\l}"];
C10 [shape="Mrecord", style="dashed", label="{M02.C10 · Conferir alteração do caso|d: O caso mudou desde que você abriu; nada foi\l   sobrescrito.\l|signos:\ld: caso/encaminhamento (S25)\ld: origem da informação (S21)\ld: horário do registro (S24)\l}"];
U [shape="box", style="rounded,filled", fillcolor="#d9d9d9", fontsize=13, margin="0.3,0.12", label="Acesso ubíquo: sair da área da clínica\nDisponível em C06–C10.\l"];
A [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Voltar a M02 · folha A\nConferir relato e novas informações"];
fim [shape="doublecircle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
C06 -> C07 [style=invis, weight=40];
C07 -> C08 [style=invis, weight=40];
REF -> C06 [label="u: perguntar ao tutor"];
REF -> C07 [label="u: informar capacidade"];
C06 -> P04 [label="u: enviar pergunta"];
C07 -> P04 [label="u: confirmar decisão"];
C07 -> C06 [label="u: perguntar antes de decidir", style="dashed"];
P04 -> C06 [label="d: mensagem vazia; escreva a\npergunta", style="dashed"];
P04 -> C09 [label="d: envio não confirmado", style="dashed"];
C09 -> P04 [label="u: conferir situação e tentar\nde novo", style="dashed"];
P04 -> C10 [label="d: estado ou versão do caso\nmudou", style="dashed"];
C10 -> A [label="u: consultar atualização e\nrevisar", style="dashed"];
P04 -> C08 [label="d: comunicação registrada"];
C08 -> P05 [label="u: consultar retorno do tutor"];
P05 -> C08 [label="d: sem resposta nova; último\nhorário"];
P05 -> A [label="d: novo complemento disponível"];
P05 -> C08 [label="d: consulta falhou; último\nestado mantido", style="dashed"];
C08 -> C07 [label="u: atualizar a decisão\nexplicitamente"];
C06 -> A [label="u: cancelar e voltar ao caso", style="dashed"];
U -> fim [label="u: sair\n[gcc: O07 · decidir se a\nunidade recebe o animal]\n(sem decisão)"];
C08 -> fim [label="u: concluir\n[gcc: O07 · decidir se a\nunidade recebe o animal]"];
}
