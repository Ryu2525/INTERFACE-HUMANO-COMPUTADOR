digraph molic {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.55", splines=polyline, fontname="Arial", fontsize=18, labelloc=t, label="M01 · folha A — Relatar e revisar sinais\nJulian Ryu Takeda — 22.224.030-1\nCenas = tópicos de conversa · u: usuário · d: preposto do designer"];
node [fontname="Arial", fontsize=14, color="#343434", penwidth=1.4, margin="0.16,0.10"];
edge [fontname="Arial", fontsize=12, color="#454545", arrowsize=0.7];
C01 [shape="Mrecord", label="{M01.C01 · Relatar sinais|d: Qual animal e o que observou?\lu+d: espécie, animal, relato e início\lS02–S04; sem cadastro completo\l}", style="solid"];
inicio [shape="circle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
C02 [shape="Mrecord", label="{M01.C02 · Gravar relato|d: Gravação em andamento; pode cancelar.\lu+d: áudio opcional; S05 após transcrição\l}", style="solid"];
P01 [shape="square", style="filled", fillcolor="black", width="0.23", height="0.23", fixedsize="true", label="", xlabel="P01"];
P02 [shape="square", style="filled", fillcolor="black", width="0.23", height="0.23", fixedsize="true", label="", xlabel="P02"];
C03 [shape="Mrecord", label="{M01.C03 · Conferir o que será enviado|d: Confira texto e animal; ainda não\nenviado.\lu+d: corrigir relato/transcrição;\nS02/S03/S05\l}", style="solid"];
C04 [shape="Mrecord", label="{M01.C04 · Acompanhar análise|d: Relato recebido; análise em andamento.\ld: S08; sem resultado presumido\l}", style="solid"];
C05 [shape="Mrecord", label="{M01.C05 · Recuperar o relato|d: Não foi possível concluir; texto mantido.\lu+d: retentar ou corrigir; S03/S08\l}", style="dashed"];
C06 [shape="Mrecord", label="{M01.C06 · Esclarecer lacuna|d: Falta esta observação; não é não\nemergência.\lu+d: pergunta, resposta ou não sei; S06/S07\ld: sem avanço, contato profissional\ndisponível\l}", style="solid"];
C07 [shape="Mrecord", label="{M01.C07 · Compreender orientação|d: orientação, motivos, limites e próximo\npasso\lu+d: S09–S12/S21/S24; animal e horário\ld: não emergência inclui\nobservação/reavaliação\l}", style="solid"];
B [shape="note", style="filled", fillcolor="#f1f5f9", label="Continuar em M01 · folha B\nMesma conversa: localizar e contatar clínica"];
U [shape="Mrecord", label="{Acesso ubíquo: buscar ajuda|Disponível nas cenas C01–C07\lNão depende de concluir cadastro/análise\l}", style="filled", fillcolor="#cccccc"];
fim [shape="doublecircle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
C04 -> C06 -> C07 [style=invis, weight=100];
inicio -> C01 [label="u: iniciar pré-triagem [gco:\nrelatar sinais]"];
C01 -> C03 [label="u: digitei; quero revisar"];
C01 -> C02 [label="u: prefiro gravar [se voz\ndisponível]"];
C02 -> P01 [label="u: terminar gravação"];
C02 -> C01 [label="u: cancelar áudio e digitar", style="dashed"];
P01 -> C03 [label="d: transcrição pronta;\nconfira"];
P01 -> C01 [label="d: áudio indisponível; use\ntexto", style="dashed"];
C03 -> C01 [label="u: corrigir relato ou animal", style="dashed"];
C03 -> P02 [label="u: confirmei; enviar para\nanálise"];
P02 -> C03 [label="d: informe espécie e relato\nnão vazio", style="dashed"];
P02 -> C04 [label="d: dados recebidos;\nanalisando"];
C04 -> P02 [label="u: consultar andamento"];
P02 -> C05 [label="d: falha na análise", style="dashed"];
C05 -> P02 [label="u: tentar novamente", style="dashed"];
C05 -> C03 [label="u: editar antes de retentar", style="dashed"];
P02 -> C06 [label="d: informações insuficientes"];
C06 -> P02 [label="u: enviar complemento\nobservado"];
P02 -> C07 [label="d: orientação disponível"];
C07 -> B [label="u: encontrar atendimento"];
C07 -> C03 [label="u: sinais mudaram; atualizar", style="dashed"];
C07 -> fim [label="u: encerrar leitura [gcc:\norientação consultada]"];
U -> B [label="u: buscar contato\nprofissional"];
}
