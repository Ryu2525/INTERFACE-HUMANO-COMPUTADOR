digraph molic {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.65", splines=true, fontname="Arial", fontsize=18, labelloc=t, label="M01 · folha A — Relatar e revisar sinais\nJulian Ryu Takeda — 22.224.030-1\nAbre o objetivo final O03 · entender o que fazer agora\nCenas = tópicos · u: usuário informa · d: sistema apresenta · u: d: informado e exibido · tracejado = alerta ou recuperação"];
node [fontname="Arial", fontsize=13, color="#343434", penwidth=1.4, margin="0.14,0.08"];
edge [fontname="Arial", fontsize=11, color="#454545", arrowsize=0.7];
inicio [shape="circle", style="filled", fillcolor="black", width="0.22", height="0.22", fixedsize="true", label=""];
C01 [shape="Mrecord", style="solid", label="{M01.C01 · Relatar sinais (O01/O08)|d: Qual animal e o que você observou? Pode\l   associar o animal depois.\l|signos:\lu: animal (S02)\lu: relato (S03)\lu: início dos sinais (S04)\ld: histórico do animal (S26)\lu: d: provedor da análise (S31)\l}"];
C02 [shape="Mrecord", style="solid", label="{M01.C02 · Gravar relato|d: Gravação em andamento; pode cancelar e\l   digitar.\l|signos:\lu: relato por voz (S03)\l}"];
P01 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P01"];
C03 [shape="Mrecord", style="solid", label="{M01.C03 · Conferir o que será enviado (O01)|d: Ainda não enviei; corrija e envie quando\l   estiver certo.\l|signos:\lu: d: relato (S03)\lu: d: transcrição (S05)\lu: d: animal (S02)\ld: provedor da análise (S31): para onde o\l      relato vai\l}"];
P02 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P02"];
C04 [shape="Mrecord", style="solid", label="{M01.C04 · Acompanhar análise|d: Recebi seu relato e estou analisando; ele\l   está guardado.\l|signos:\ld: estado da análise (S08): em análise\ld: relato (S03)\l}"];
C05 [shape="Mrecord", style="dashed", label="{M01.C05 · Recuperar o relato (O09)|d: Não consegui concluir a análise. Isso não\l   quer dizer que o caso não é grave.\l|signos:\ld: estado da análise (S08): falha\lu: d: relato (S03) mantido\ld: próximo passo (S12): procurar atendimento\l}"];
C06 [shape="Mrecord", style="solid", label="{M01.C06 · Esclarecer lacuna (O02)|d: Falta esta observação; isso não é não\l   emergência.\l|signos:\ld: orientação (S09): informação insuficiente\ld: pergunta complementar (S06)\lu: resposta complementar (S07), inclusive não\l      sei\l}"];
C07 [shape="Mrecord", style="solid", label="{M01.C07 · Compreender orientação (O03)|d: Pesaram estes sinais. Isto não é um\l   diagnóstico.\l|signos:\ld: orientação (S09)\ld: sinais considerados (S30)\ld: justificativa (S10)\ld: limites (S11)\ld: próximo passo (S12)\ld: origem da informação (S21): automática\ld: horário do registro (S24)\l}"];
U [shape="box", style="rounded,filled", fillcolor="#d9d9d9", fontsize=13, margin="0.3,0.12", label="Acesso ubíquo: buscar ajuda\nDisponível em C01–C07: link fixo e item de\l   menu.\lNão depende de concluir cadastro ou análise.\l"];
B [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Ir a M01 · folha B\nAbre o objetivo final O04 · chegar a um atendimento"];
fim [shape="doublecircle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
{rank=same; C04; C05; C06;}
