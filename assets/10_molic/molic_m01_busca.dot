digraph molic {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.65", splines=true, fontname="Arial", fontsize=18, labelloc=t, label="M01 · folha B — Localizar e contatar clínica\nJulian Ryu Takeda — 22.224.030-1\nAbre o objetivo final O04 · chegar a um atendimento (entrada a partir de M01-A, M03-A, M03-B ou do acesso ubíquo)\nCenas = tópicos · u: usuário informa · d: sistema apresenta · u: d: informado e exibido · tracejado = alerta ou recuperação"];
node [fontname="Arial", fontsize=13, color="#343434", penwidth=1.4, margin="0.14,0.08"];
edge [fontname="Arial", fontsize=11, color="#454545", arrowsize=0.7];
REF [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Vem de M01-A (C07, acesso ubíquo),\nM03-A (C06) ou M03-B (C09, C10)"];
inicio [shape="circle", style="filled", fillcolor="black", width="0.22", height="0.22", fixedsize="true", label=""];
C08 [shape="Mrecord", style="solid", label="{M01.C08 · Definir região|d: Posso usar sua localização ou você diz onde\l   está.\l|signos:\lu: região (S13): endereço ou localização\l}"];
P03 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P03"];
P04 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P04"];
C09 [shape="Mrecord", style="solid", label="{M01.C09 · Comparar opções|d: Horário publicado não confirma vaga; ligue\l   para confirmar.\l|signos:\lu: d: região (S13)\ld: clínica (S14)\ld: horário informado (S15): aberta, fechada ou\l      não informado\lu: filtro por horário informado (S15)\ld: contato (S16)\l}"];
C10 [shape="Mrecord", style="dashed", label="{M01.C10 · Rever busca|d: Não encontrei unidade aberta perto desse\l   ponto, ou a busca falhou.\l|signos:\lu: d: região (S13)\ld: horário informado (S15)\l}"];
C11 [shape="Mrecord", style="solid", label="{M01.C11 · Contatar a unidade|d: Nenhuma unidade tem atendimento confirmado\l   até que ela confirme.\l|signos:\ld: clínica (S14)\ld: horário informado (S15)\ld: contato (S16)\l}"];
C12 [shape="Mrecord", style="dashed", label="{M01.C12 · Prosseguir sem integração|d: Esta unidade não recebe o resumo pela\l   plataforma; use o contato direto.\l|signos:\ld: clínica (S14): sem integração\ld: contato (S16)\l}"];
C [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Continua em M01 · folha C\nMesmo objetivo O04: revisar, autorizar e acompanhar"];
fim [shape="doublecircle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
C09 -> C11 [style=invis, weight=40];
C11 -> C12 [style=invis, weight=40];
REF -> inicio;
inicio -> C08 [label="u: encontrar atendimento\n[gco: O04 · chegar a um\natendimento]"];
C08 -> P03 [label="u: usar minha localização"];
P03 -> C08 [label="d: permissão negada ou falha;\ninforme a região", style="dashed"];
P03 -> P04 [label="d: região obtida; buscando"];
C08 -> P04 [label="u: buscar pela região digitada"];
P04 -> C09 [label="d: opções encontradas"];
P04 -> C10 [label="d: nenhuma opção ou erro", style="dashed"];
C10 -> C08 [label="u: ajustar região e retentar", style="dashed"];
C09 -> P04 [label="u: aplicar ou remover filtro"];
C09 -> C11 [label="u: contatar esta clínica"];
C11 -> C09 [label="u: sem resposta; outra opção", style="dashed"];
C11 -> C [label="u: compartilhar o caso\n[unidade habilitada]"];
C11 -> C12 [label="u: preparar contato\n[unidade sem integração]"];
C12 -> C09 [label="u: procurar outra unidade", style="dashed"];
C11 -> fim [label="u: seguir pelo contato direto\n[gcc: O04 · chegar a um\natendimento]"];
C08 -> fim [label="u: desistir da busca\n[gcc: O04 · chegar a um\natendimento]\n(sem unidade escolhida)"];
}
