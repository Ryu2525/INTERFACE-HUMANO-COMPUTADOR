digraph molic {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.65", splines=true, fontname="Arial", fontsize=18, labelloc=t, label="M02 · folha A — Consultar caso autorizado\nVinícius de Castro Duarte — 22.224.020-2\nAbre o objetivo final O07 · decidir se a unidade recebe o animal\nCenas = tópicos · u: usuário informa · d: sistema apresenta · u: d: informado e exibido · tracejado = alerta ou recuperação"];
node [fontname="Arial", fontsize=13, color="#343434", penwidth=1.4, margin="0.14,0.08"];
edge [fontname="Arial", fontsize=11, color="#454545", arrowsize=0.7];
inicio [shape="circle", style="filled", fillcolor="black", width="0.22", height="0.22", fixedsize="true", label=""];
C01 [shape="Mrecord", style="solid", label="{M02.C01 · Identificar acesso da clínica|d: Você verá só os casos autorizados à sua\l   unidade.\l|signos:\lu: usuário (S01)\lu: senha (S28)\ld: papel (S29): profissional da clínica\l}"];
P01 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P01"];
P02 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P02"];
P03 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P03"];
C02 [shape="Mrecord", style="solid", label="{M02.C02 · Escolher encaminhamento (O06)|d: Casos compartilhados com sua unidade, do\l   mais recente ao mais antigo.\l|signos:\ld: caso/encaminhamento (S25)\ld: animal (S02)\ld: estado do encaminhamento (S20)\ld: horário do registro (S24)\l}"];
C03 [shape="Mrecord", style="solid", label="{M02.C03 · Conferir origem do caso (O06)|d: Este trecho foi informado pelo tutor; esta\l   orientação é automática. Sem dado não\l   significa sinal ausente.\l|signos:\ld: resumo (S17)\ld: relato original (S03)\ld: início dos sinais (S04)\ld: orientação (S09)\ld: sinais considerados (S30)\ld: justificativa (S10)\ld: origem da informação (S21)\ld: horário do registro (S24)\l}"];
C04 [shape="Mrecord", style="dashed", label="{M02.C04 · Recuperar consulta|d: Nenhum caso novo foi compartilhado com sua\l   unidade, ou a consulta falhou.\l|signos:\ld: caso/encaminhamento (S25)\ld: destinatário (S18)\ld: autorização (S19)\l}"];
C05 [shape="Mrecord", style="dashed", label="{M02.C05 · Rever permissão|d: Sessão inválida ou acesso não permitido;\l   nenhum conteúdo privado foi exibido.\l|signos:\lu: usuário (S01)\ld: papel (S29)\l}"];
U [shape="box", style="rounded,filled", fillcolor="#d9d9d9", fontsize=13, margin="0.3,0.12", label="Acesso ubíquo: sair da área da clínica\nDisponível em C02–C04 e na folha B.\lSem atalho para casos privados.\l"];
B [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Continua em M02 · folha B\nMesmo objetivo O07: pedir complemento e decidir"];
fim [shape="doublecircle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
inicio -> C01 [style=invis, weight=40];
C01 -> P01 [style=invis, weight=40];
P01 -> C02 [style=invis, weight=40];
C02 -> P03 [style=invis, weight=40];
P03 -> C03 [style=invis, weight=40];
C03 -> B [style=invis, weight=40];
inicio -> C01 [label="u: abrir área da clínica\n[gco: O07 · decidir se a\nunidade recebe o animal]"];
C01 -> P01 [label="u: entrar com vínculo da\nunidade"];
P01 -> C02 [label="d: acesso autorizado"];
P01 -> C05 [label="d: acesso inválido ou sem\npermissão", style="dashed"];
C05 -> C01 [label="u: corrigir acesso", style="dashed"];
C02 -> P02 [label="u: atualizar encaminhamentos"];
P02 -> C02 [label="d: lista atualizada"];
P02 -> C04 [label="d: lista vazia ou erro\nidentificado", style="dashed"];
C04 -> P02 [label="u: tentar atualizar", style="dashed"];
C02 -> P03 [label="u: abrir este caso"];
P03 -> C03 [label="d: caso autorizado e versão\ndisponível"];
P03 -> C05 [label="d: sessão expirada ou caso não\nautorizado", style="dashed"];
C05 -> C02 [label="u: voltar à lista permitida", style="dashed"];
C03 -> P03 [label="u: conferir atualização do\nrelato"];
P03 -> C04 [label="d: falha de consulta", style="dashed"];
C03 -> B [label="u: pedir complemento ou\ndecidir"];
C03 -> C02 [label="u: voltar aos encaminhamentos"];
C05 -> fim [label="u: sair\n[gcc: O07 · decidir se a\nunidade recebe o animal]\n(sem acesso)"];
U -> fim [label="u: sair\n[gcc: O07 · decidir se a\nunidade recebe o animal]\n(sem decisão)"];
}
