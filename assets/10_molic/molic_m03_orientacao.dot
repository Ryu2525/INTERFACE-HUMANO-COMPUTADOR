digraph molic {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.65", splines=true, fontname="Arial", fontsize=18, labelloc=t, label="M03 · folha B — Compreender e agir\nJoão Pedro Gardenghi Peterutto — 22.125.066-5\nContinua o objetivo final O03 · entender o que fazer agora (sem nova abertura)\nCenas = tópicos · u: usuário informa · d: sistema apresenta · u: d: informado e exibido · tracejado = alerta ou recuperação"];
node [fontname="Arial", fontsize=13, color="#343434", penwidth=1.4, margin="0.14,0.08"];
edge [fontname="Arial", fontsize=11, color="#454545", arrowsize=0.7];
REF [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Continua de M03 · folha A (P01)\nMesmo objetivo O03; sem nova abertura"];
C07 [shape="Mrecord", style="solid", label="{M03.C07 · Interpretar orientação (O03)|d: Veja a orientação, os sinais considerados,\l   seus limites e o próximo passo.\l|signos:\ld: orientação (S09)\ld: sinais considerados (S30)\ld: limites (S11)\ld: origem da informação (S21): automática\ld: animal (S02)\ld: horário do registro (S24)\l}"];
C08 [shape="Mrecord", style="solid", label="{M03.C08 · Esclarecer motivos e limites|d: Justificativa em linguagem simples.\l   Conteúdo automático não é diagnóstico.\l|signos:\ld: justificativa (S10)\ld: relato (S03)\ld: sinais considerados (S30)\ld: limites (S11)\l}"];
P02 [shape="square", style="filled", fillcolor="black", width="0.24", height="0.24", fixedsize="true", label="", xlabel="P02"];
C09 [shape="Mrecord", style="solid", label="{M03.C09 · Planejar observação e reavaliação|d: Não identifiquei sinal de emergência. Isto\l   não é um diagnóstico: continue\l   acompanhando.\l|signos:\ld: próximo passo (S12): acompanhar e reavaliar\ld: limites (S11): sinais que mudam a\l      orientação\ld: horário do registro (S24)\l}"];
C10 [shape="Mrecord", style="dashed", label="{M03.C10 · Priorizar atendimento|d: Possível emergência: procure atendimento\l   agora; não espere cadastro nem perguntas.\l|signos:\ld: orientação (S09): possível emergência\ld: próximo passo (S12): procurar atendimento\ld: limites (S11)\l}"];
A [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Voltar a M03 · folha A\nNova observação; corrigir animal ou relato"];
H [shape="note", style="filled", fillcolor="#f1f5f9", fontsize=13, label="Ir a M01 · folha B\nAbre o objetivo final O04 · chegar a um atendimento"];
fim [shape="doublecircle", style="filled", fillcolor="black", width="0.20", height="0.20", fixedsize="true", label=""];
C07 -> P02 [style=invis, weight=40];
REF -> C07 [label="d: orientação disponível"];
C07 -> C08 [label="u: quero entender os motivos"];
C08 -> C07 [label="u: voltar à orientação"];
C07 -> P02 [label="u: o que faço agora?"];
P02 -> C09 [label="d: não emergência: acompanhe e\nreavalie"];
P02 -> C10 [label="d: possível emergência:\nprocure atendimento agora"];
C10 -> H [label="u: encontrar atendimento agora"];
C09 -> H [label="u: tenho dúvida; contatar\nprofissional"];
C07 -> A [label="u: animal ou relato incorreto", style="dashed"];
C09 -> A [label="u: observei mudança; atualizar\nrelato", style="dashed"];
C09 -> fim [label="u: encerrar consulta\n[gcc: O03 · entender o que\nfazer agora]"];
C10 -> fim [label="u: seguir por contato já\nconhecido\n[gcc: O03 · entender o que\nfazer agora]"];
